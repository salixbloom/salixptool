<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Application.controllers.NewCanvasController">
   <BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="150.0" prefWidth="300.0" >
      <bottom>
         <ButtonBar prefHeight="40.0" prefWidth="200.0" BorderPane.alignment="CENTER">
           <buttons>
             <Button fx:id="cancelButton" mnemonicParsing="false" text="Cancel" />
               <Button fx:id="confirmButton" mnemonicParsing="false" text="Confirm" />
           </buttons>
            <BorderPane.margin>
               <Insets />
            </BorderPane.margin>
            <padding>
               <Insets bottom="10.0" right="10.0" />
            </padding>
         </ButtonBar>
      </bottom>
      <top>
         <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Input Canvas Dimensions" BorderPane.alignment="TOP_LEFT">
            <font>
               <Font size="20.0" />
            </font>
            <BorderPane.margin>
               <Insets bottom="5.0" left="10.0" top="5.0" />
            </BorderPane.margin>
         </Text>
      </top>
      <center>
         <FlowPane alignment="TOP_CENTER" columnHalignment="CENTER" prefHeight="200.0" prefWidth="200.0"
                   BorderPane.alignment="CENTER">
            <BorderPane.margin>
               <Insets top="10.0"/>
            </BorderPane.margin>
            <TextField fx:id="widthField" maxWidth="120.0" promptText="Width"/>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="x">
               <FlowPane.margin>
                  <Insets left="10.0" right="10.0"/>
               </FlowPane.margin>
            </Text>
            <TextField fx:id="heightField" maxWidth="120.0" promptText="Height">
               <FlowPane.margin>
                  <Insets/>
               </FlowPane.margin>
            </TextField>
            <Label fx:id="calculatedSize" alignment="CENTER" minWidth="150.0" text="MAX SIZE: 0 Kb">
               <FlowPane.margin>
                  <Insets top="10.0"/>
               </FlowPane.margin>
            </Label>
         </FlowPane>
      </center>
   </BorderPane>
</VBox>
